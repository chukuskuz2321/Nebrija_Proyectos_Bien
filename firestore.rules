rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'adrianbelvis14@gmail.com'
      );
    }

    function isParentProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isParentProjectMember(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids
      );
    }

    // 1. UserProfile Blueprint (Zero PII — Public Student Directory)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'role', 'searchable', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'searchable', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 40 && data.username.matches('^[a-z0-9_.\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
        data.searchable is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 2. Project Blueprint (Multi-member + Explorar Proyectos)
    function isValidProject(data) {
      return data.keys().hasAll([
          'id', 'name', 'subject', 'description', 'ownerId', 'ownerUsername',
          'hasPassword', 'passwordHash', 'visibility', 'authorizedUsernames', 'memberUids',
          'dueDate', 'driveFolderId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'subject', 'description', 'ownerId', 'ownerUsername',
          'hasPassword', 'passwordHash', 'visibility', 'authorizedUsernames', 'memberUids',
          'dueDate', 'driveFolderId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
        data.description is string && data.description.size() <= 1000 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUsername is string && data.ownerUsername.size() >= 2 && data.ownerUsername.size() <= 40 &&
        data.hasPassword is bool &&
        data.passwordHash is string && data.passwordHash.size() <= 128 &&
        data.visibility is string && data.visibility.size() >= 5 && data.visibility.size() <= 10 &&
        (data.visibility == 'class' || data.visibility == 'private') &&
        data.authorizedUsernames is list && data.authorizedUsernames.size() >= 1 && data.authorizedUsernames.size() <= 50 && data.authorizedUsernames[0] is string &&
        data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string &&
        data.dueDate is string && data.dueDate.size() <= 40 &&
        data.driveFolderId is string && data.driveFolderId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 3. ProjectWorkspaceState Blueprint (Shared Real-Time State Doc for Members)
    function isValidProjectWorkspaceState(data) {
      return data.keys().hasAll([
          'projectId', 'updatedBy', 'folders', 'documents', 'tasks', 'notices', 'messages', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'projectId', 'updatedBy', 'folders', 'documents', 'tasks', 'notices', 'messages', 'updatedAt'
        ]) &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.updatedBy == request.auth.uid &&
        data.folders is list && data.folders.size() <= 200 &&
        data.documents is list && data.documents.size() <= 200 &&
        data.tasks is list && data.tasks.size() <= 200 &&
        data.notices is list && data.notices.size() <= 200 &&
        data.messages is list && data.messages.size() <= 300 &&
        data.updatedAt is timestamp;
    }

    // 4. ProjectInvitation Blueprint (Real-Time Notification System)
    function isValidProjectInvitation(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'projectName', 'projectSubject', 'fromUid', 'fromUsername',
          'toUid', 'toUsername', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'projectName', 'projectSubject', 'fromUid', 'fromUsername',
          'toUid', 'toUsername', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 120 &&
        data.projectSubject is string && data.projectSubject.size() <= 80 &&
        data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128 && data.fromUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fromUsername is string && data.fromUsername.size() >= 2 && data.fromUsername.size() <= 40 &&
        data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128 && data.toUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.toUsername is string && data.toUsername.size() >= 2 && data.toUsername.size() <= 40 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 10 &&
        (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 5. ProjectMember Blueprint
    function isValidProjectMember(data) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'username', 'createdAt']) &&
        data.keys().hasOnly(['id', 'projectId', 'ownerId', 'username', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 40 && data.username.matches('^[a-z0-9_.\\-]+$') &&
        data.createdAt is timestamp;
    }

    // 6. Folder Blueprint
    function isValidFolder(data) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'parentId', 'name', 'driveFolderId', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'projectId', 'ownerId', 'parentId', 'name', 'driveFolderId', 'createdBy', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.parentId is string && data.parentId.size() >= 1 && data.parentId.size() <= 128 && data.parentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.driveFolderId is string && data.driveFolderId.size() <= 128 &&
        data.createdBy is string && data.createdBy.size() >= 2 && data.createdBy.size() <= 40 &&
        data.createdAt is timestamp;
    }

    // 7. ProjectDocument Blueprint
    function isValidProjectDocument(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'ownerId', 'folderId', 'title', 'content',
          'googleDocId', 'googleDocUrl', 'assigneeUsername', 'status', 'lastModifiedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'folderId', 'title', 'content',
          'googleDocId', 'googleDocUrl', 'assigneeUsername', 'status', 'lastModifiedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.folderId is string && data.folderId.size() >= 1 && data.folderId.size() <= 128 && data.folderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.content is string && data.content.size() <= 50000 &&
        data.googleDocId is string && data.googleDocId.size() <= 128 &&
        data.googleDocUrl is string && data.googleDocUrl.size() <= 500 &&
        data.assigneeUsername is string && data.assigneeUsername.size() <= 40 &&
        data.status is string && data.status.size() >= 5 && data.status.size() <= 20 &&
        (data.status == 'draft' || data.status == 'in_review' || data.status == 'completed') &&
        data.lastModifiedBy is string && data.lastModifiedBy.size() >= 1 && data.lastModifiedBy.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 8. ProjectTask Blueprint
    function isValidProjectTask(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'ownerId', 'title', 'description', 'assigneeUsername',
          'dueDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'title', 'description', 'assigneeUsername',
          'dueDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 1000 &&
        data.assigneeUsername is string && data.assigneeUsername.size() <= 40 &&
        data.dueDate is string && data.dueDate.size() <= 40 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 15 &&
        (data.status == 'pending' || data.status == 'in_progress' || data.status == 'completed') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 9. ProjectNotice Blueprint
    function isValidProjectNotice(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'ownerId', 'title', 'message',
          'priority', 'authorUsername', 'targetUsername', 'archived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'title', 'message',
          'priority', 'authorUsername', 'targetUsername', 'archived', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.priority is string && data.priority.size() >= 6 && data.priority.size() <= 12 &&
        (data.priority == 'normal' || data.priority == 'important' || data.priority == 'urgent') &&
        data.authorUsername is string && data.authorUsername.size() >= 2 && data.authorUsername.size() <= 40 &&
        data.targetUsername is string && data.targetUsername.size() >= 2 && data.targetUsername.size() <= 40 &&
        data.archived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 10. CodeSnippet Blueprint
    function isValidCodeSnippet(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'ownerId', 'folderId', 'title',
          'language', 'code', 'authorUsername', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'folderId', 'title',
          'language', 'code', 'authorUsername', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.folderId is string && data.folderId.size() >= 1 && data.folderId.size() <= 128 && data.folderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 20000 &&
        data.authorUsername is string && data.authorUsername.size() >= 2 && data.authorUsername.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 11. ChatMessage Blueprint
    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'senderUsername', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'projectId', 'ownerId', 'senderUsername', 'text', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.senderUsername is string && data.senderUsername.size() >= 2 && data.senderUsername.size() <= 40 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    // Admins collection (Read-only for verified admin lookup)
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // /users/{userId} — Public non-PII student profiles for autocomplete discovery
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (existing().searchable == true || request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && (existing().searchable == true || existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'role', 'searchable', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // /invitations/{invitationId} — Real-Time Project Invitations
    match /invitations/{invitationId} {
      allow get: if isVerified() && isValidId(invitationId) && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(invitationId) &&
        isValidProjectInvitation(incoming()) &&
        incoming().id == invitationId &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isParentProjectMember(incoming().projectId);
      allow update: if isVerified() && isValidId(invitationId) &&
        isValidProjectInvitation(incoming()) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().status == 'pending' &&
            existing().toUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && isValidId(invitationId) && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid || isAdmin());
    }

    // /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isVerified() && isValidId(projectId) && (existing().visibility == 'class' || existing().ownerId == request.auth.uid || request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isVerified() && (existing().visibility == 'class' || existing().ownerId == request.auth.uid || request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerified() && isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == projectId &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Owner updates project configuration
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'subject', 'description', 'hasPassword', 'passwordHash', 'visibility',
              'authorizedUsernames', 'memberUids', 'dueDate', 'driveFolderId', 'updatedAt'
            ])
          ) ||
          // Action 2: Verified student joins an open/password-unlocked or invited project
          (existing().visibility == 'class' &&
            request.auth.uid in incoming().memberUids &&
            incoming().memberUids.hasAll(existing().memberUids) &&
            incoming().authorizedUsernames.hasAll(existing().authorizedUsernames) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'memberUids', 'authorizedUsernames', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(projectId) && (existing().ownerId == request.auth.uid || isAdmin());

      // /projects/{projectId}/state/{stateId} — Shared Workspace State Document (Master Gate)
      match /state/{stateId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(stateId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if false;
        allow create: if isVerified() && isValidId(projectId) && isValidId(stateId) &&
          isValidProjectWorkspaceState(incoming()) &&
          incoming().projectId == projectId &&
          incoming().updatedAt == request.time &&
          (isParentProjectMember(projectId) || isAdmin());
        allow update: if isVerified() && isValidId(projectId) && isValidId(stateId) &&
          isValidProjectWorkspaceState(incoming()) &&
          incoming().projectId == existing().projectId &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isParentProjectMember(projectId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'updatedBy', 'folders', 'documents', 'tasks', 'notices', 'messages', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerified() && isValidId(projectId) && isValidId(stateId) && (isParentProjectOwner(projectId) || isAdmin());
      }

      // /projects/{projectId}/members/{memberId}
      match /members/{memberId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(memberId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(memberId) &&
          isValidProjectMember(incoming()) &&
          incoming().id == memberId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(projectId) && isValidId(memberId) && (isParentProjectOwner(projectId) || isAdmin());
      }

      // /projects/{projectId}/folders/{folderId}
      match /folders/{folderId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(folderId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(folderId) &&
          isValidFolder(incoming()) &&
          incoming().id == folderId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(projectId) && isValidId(folderId) && (isParentProjectMember(projectId) || isAdmin());
      }

      // /projects/{projectId}/documents/{documentId}
      match /documents/{documentId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(documentId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(documentId) &&
          isValidProjectDocument(incoming()) &&
          incoming().id == documentId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if isVerified() && isValidId(projectId) && isValidId(documentId) &&
          isValidProjectDocument(incoming()) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (existing().status != 'completed' && isParentProjectMember(projectId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'folderId', 'title', 'content', 'googleDocId', 'googleDocUrl',
                'assigneeUsername', 'status', 'lastModifiedBy', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerified() && isValidId(projectId) && isValidId(documentId) && (isParentProjectMember(projectId) || isAdmin());
      }

      // /projects/{projectId}/tasks/{taskId}
      match /tasks/{taskId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(taskId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(taskId) &&
          isValidProjectTask(incoming()) &&
          incoming().id == taskId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if isVerified() && isValidId(projectId) && isValidId(taskId) &&
          isValidProjectTask(incoming()) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (existing().status != 'completed' && isParentProjectMember(projectId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'assigneeUsername', 'dueDate', 'status', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerified() && isValidId(projectId) && isValidId(taskId) && (isParentProjectMember(projectId) || isAdmin());
      }

      // /projects/{projectId}/notices/{noticeId}
      match /notices/{noticeId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(noticeId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(noticeId) &&
          isValidProjectNotice(incoming()) &&
          incoming().id == noticeId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if isVerified() && isValidId(projectId) && isValidId(noticeId) &&
          isValidProjectNotice(incoming()) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isParentProjectMember(projectId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'message', 'priority', 'archived', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerified() && isValidId(projectId) && isValidId(noticeId) && (isParentProjectMember(projectId) || isAdmin());
      }

      // /projects/{projectId}/snippets/{snippetId}
      match /snippets/{snippetId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(snippetId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(snippetId) &&
          isValidCodeSnippet(incoming()) &&
          incoming().id == snippetId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if isVerified() && isValidId(projectId) && isValidId(snippetId) &&
          isValidCodeSnippet(incoming()) &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isParentProjectMember(projectId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'folderId', 'title', 'language', 'code', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerified() && isValidId(projectId) && isValidId(snippetId) && (isParentProjectMember(projectId) || isAdmin());
      }

      // /projects/{projectId}/messages/{messageId}
      match /messages/{messageId} {
        allow get: if isVerified() && isValidId(projectId) && isValidId(messageId) && (isParentProjectMember(projectId) || isAdmin());
        allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(projectId) && isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().projectId == projectId &&
          incoming().createdAt == request.time &&
          isParentProjectMember(projectId);
        allow update: if false;
        allow delete: if isVerified() && isValidId(projectId) && isValidId(messageId) && (isParentProjectMember(projectId) || isAdmin());
      }
    }
  }
}
