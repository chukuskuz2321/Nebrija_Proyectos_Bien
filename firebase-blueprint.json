{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public directory profile for a student user in the workspace without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username for classmate discovery.",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_.\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Visible display name of the student.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Student role or specialty.",
          "minLength": 1,
          "maxLength": 80
        },
        "searchable": {
          "type": "boolean",
          "description": "Whether the student appears in classmate invitation autocomplete."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "username", "displayName", "role", "searchable", "createdAt", "updatedAt"]
    },
    "UserDesktopPreferences": {
      "title": "UserDesktopPreferences",
      "description": "Private per-user Windows desktop widget layout and PC notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "widgets": {
          "type": "array",
          "description": "Bounded list of user-customized desktop widgets (max 12)."
        },
        "notifications": {
          "type": "object",
          "description": "Per-category PC desktop notification toggles."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "widgets", "notifications", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Collaborative computer science project discoverable in Explorar Proyectos with optional password protection.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Project title.",
          "minLength": 1,
          "maxLength": 120
        },
        "subject": {
          "type": "string",
          "description": "Course or subject name.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Project summary and objectives.",
          "minLength": 0,
          "maxLength": 1000
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the project creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUsername": {
          "type": "string",
          "description": "Username of the project creator.",
          "minLength": 2,
          "maxLength": 40
        },
        "hasPassword": {
          "type": "boolean",
          "description": "Whether the project requires a password for non-members."
        },
        "passwordHash": {
          "type": "string",
          "description": "Project access password.",
          "minLength": 0,
          "maxLength": 128
        },
        "visibility": {
          "type": "string",
          "description": "Discovery scope for Explorar Proyectos.",
          "enum": ["class", "private"],
          "minLength": 5,
          "maxLength": 10
        },
        "authorizedUsernames": {
          "type": "array",
          "description": "Bounded list of authorized member usernames (max 50)."
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list of authorized member Firebase Auth UIDs (max 50)."
        },
        "dueDate": {
          "type": "string",
          "description": "ISO date string for the project deadline.",
          "minLength": 0,
          "maxLength": 40
        },
        "driveFolderId": {
          "type": "string",
          "description": "Synchronized Google Drive root folder ID for this project.",
          "minLength": 0,
          "maxLength": 128
        },
        "githubUrl": {
          "type": "string",
          "description": "Optional public GitHub repository URL for read-only commits and branches widget.",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "name",
        "subject",
        "description",
        "ownerId",
        "ownerUsername",
        "hasPassword",
        "passwordHash",
        "visibility",
        "authorizedUsernames",
        "memberUids",
        "dueDate",
        "driveFolderId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectWorkspaceState": {
      "title": "ProjectWorkspaceState",
      "description": "Single-document synchronized state for project folders, documents metadata, tasks, notices, and team messages accessible to all current project members.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "folders": {
          "type": "array",
          "description": "Bounded list of project folders."
        },
        "documents": {
          "type": "array",
          "description": "Bounded list of project document entries."
        },
        "tasks": {
          "type": "array",
          "description": "Bounded list of project tasks."
        },
        "notices": {
          "type": "array",
          "description": "Bounded list of project notices."
        },
        "messages": {
          "type": "array",
          "description": "Bounded list of project chat messages."
        },
        "activities": {
          "type": "array",
          "description": "Bounded audit log array of the last 30 project events stored inside the existing state document."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["projectId", "updatedBy", "folders", "documents", "tasks", "notices", "messages", "updatedAt"]
    },
    "TeacherShowcase": {
      "title": "TeacherShowcase",
      "description": "Public read-only presentation projection for ?modo=profesor without PII, passwords, internal notices, or team chat.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "ownerUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "authorizedUsernames": { "type": "array", "description": "Bounded list of team member usernames (max 50)." },
        "dueDate": { "type": "string", "minLength": 0, "maxLength": 40 },
        "githubUrl": { "type": "string", "minLength": 0, "maxLength": 300 },
        "folders": { "type": "array", "description": "Bounded list of project folders (max 200)." },
        "documents": { "type": "array", "description": "Bounded list of final project files (max 200)." },
        "tasks": { "type": "array", "description": "Bounded list of tasks for participation stats & burndown (max 200)." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "name", "subject", "description", "ownerUsername", "authorizedUsernames", "dueDate", "githubUrl", "folders", "documents", "tasks", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Real-time in-app notification for task assignment and @username mentions in project notice boards.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "type": "string", "enum": ["task_assigned", "mention", "deadline_48h"], "minLength": 7, "maxLength": 20 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "targetSection": { "type": "string", "enum": ["overview", "files", "tasks", "notices", "stats"], "minLength": 5, "maxLength": 12 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "toUid", "toUsername", "fromUid", "fromUsername", "projectId", "projectName", "kind", "title", "message", "targetSection", "read", "createdAt"]
    },
    "ProjectInvitation": {
      "title": "ProjectInvitation",
      "description": "Real-time project membership invitation notification sent from a project member to a registered student.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "projectSubject": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUsername": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUsername": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"],
          "minLength": 7,
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "projectId",
        "projectName",
        "projectSubject",
        "fromUid",
        "fromUsername",
        "toUid",
        "toUsername",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectMember": {
      "title": "ProjectMember",
      "description": "Authorized classmate username in a project subcollection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9_.\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "username", "createdAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Folder or nested subfolder inside a project replicated in Google Drive.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "driveFolderId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdBy": { "type": "string", "minLength": 2, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "parentId", "name", "driveFolderId", "createdBy", "createdAt"]
    },
    "ProjectDocument": {
      "title": "ProjectDocument",
      "description": "Collaborative document synchronized with Google Docs inside a project folder.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "folderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "content": { "type": "string", "minLength": 0, "maxLength": 50000 },
        "googleDocId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "googleDocUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "assigneeUsername": { "type": "string", "minLength": 0, "maxLength": 40 },
        "status": { "type": "string", "enum": ["draft", "in_review", "completed"], "minLength": 5, "maxLength": 20 },
        "lastModifiedBy": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "folderId", "title", "content", "googleDocId", "googleDocUrl", "assigneeUsername", "status", "lastModifiedBy", "createdAt", "updatedAt"]
    },
    "ProjectTask": {
      "title": "ProjectTask",
      "description": "Shared group task with title, description, authorized assignee, and 3-stage status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "assigneeUsername": { "type": "string", "minLength": 0, "maxLength": 40 },
        "dueDate": { "type": "string", "minLength": 0, "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"], "minLength": 7, "maxLength": 15 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "title", "description", "assigneeUsername", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "ProjectNotice": {
      "title": "ProjectNotice",
      "description": "Announcement on the project notice board.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"], "minLength": 6, "maxLength": 12 },
        "authorUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "targetUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "title", "message", "priority", "authorUsername", "targetUsername", "archived", "createdAt", "updatedAt"]
    },
    "CodeSnippet": {
      "title": "CodeSnippet",
      "description": "Shared source code snippet.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "folderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "language": { "type": "string", "minLength": 1, "maxLength": 30 },
        "code": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "authorUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "folderId", "title", "language", "code", "authorUsername", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message in the project team chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "ownerId", "senderUsername", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public student user profiles (no PII) indexed by Firebase UID for user autocomplete."
    },
    "/users/{userId}/private/{prefId}": {
      "schema": "UserDesktopPreferences",
      "description": "Strictly owner-only desktop widget configurations and Windows notification preferences."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Top-level group computer science projects discoverable in Explorar Proyectos."
    },
    "/projects/{projectId}/state/{stateId}": {
      "schema": "ProjectWorkspaceState",
      "description": "Real-time shared workspace state document for authorized project members."
    },
    "/projects/{projectId}/showcase/{showcaseId}": {
      "schema": "TeacherShowcase",
      "description": "Public read-only presentation document for ?modo=profesor (direct get only, no list)."
    },
    "/invitations/{invitationId}": {
      "schema": "ProjectInvitation",
      "description": "Real-time project invitation notifications."
    },
    "/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Real-time in-app notifications for task assignments and @username mentions."
    },
    "/projects/{projectId}/members/{memberId}": {
      "schema": "ProjectMember",
      "description": "Authorized usernames subcollection for passwordless project access."
    },
    "/projects/{projectId}/folders/{folderId}": {
      "schema": "Folder",
      "description": "Folders and nested subfolders inside a project."
    },
    "/projects/{projectId}/documents/{documentId}": {
      "schema": "ProjectDocument",
      "description": "Synchronized Google Docs documents inside a project."
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "ProjectTask",
      "description": "Collaborative tasks inside a project."
    },
    "/projects/{projectId}/notices/{noticeId}": {
      "schema": "ProjectNotice",
      "description": "Team notices and alerts inside a project."
    },
    "/projects/{projectId}/snippets/{snippetId}": {
      "schema": "CodeSnippet",
      "description": "Code snippets inside a project."
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Team chat messages inside a project."
    }
  }
}
