        }
      },
      "required": [
        "id",
        "projectId",
        "ownerId",
        "folderId",
        "title",
        "language",
        "code",
        "authorUsername",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message in the project team chat.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID.",
          "minLength": 1,
