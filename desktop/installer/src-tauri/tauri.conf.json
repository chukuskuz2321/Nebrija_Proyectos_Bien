{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proyectos Nebrija Setup",
  "version": "1.0.0",
  "identifier": "com.nebrija.proyectos.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "installer",
        "title": "Instalador - Proyectos Nebrija App",
        "width": 820,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
