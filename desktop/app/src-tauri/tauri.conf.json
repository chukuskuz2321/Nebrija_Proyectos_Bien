{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proyectos Nebrija App",
  "version": "1.0.0",
  "identifier": "com.nebrija.proyectos.app",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Proyectos Nebrija App",
        "url": "https://nebrija-proyectos-bien.vercel.app",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
